# Postgres on Neon. Use the POOLED connection string (host contains "-pooler").
# Put real values in .env.local (gitignored), never in this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Vercel Blob, PRIVATE store (Day 2: voice notes and photos). On Vercel, connecting
# the store to the project sets BLOB_STORE_ID and the SDK authenticates with OIDC.
# Locally, either `vercel env pull` (BLOB_STORE_ID + VERCEL_OIDC_TOKEN) or set
# BLOB_READ_WRITE_TOKEN. With none of these, dev stores media in .data/media.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Set to 1 to allow the local .data/media fallback under `pnpm start` (production build).
SITESYNC_LOCAL_MEDIA=

# --- Later days (unused on Day 1) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
