# Postgres on Neon. Use the POOLED connection string (host contains "-pooler").
# Put real values in .env.local (gitignored), never in this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Vercel Blob, PRIVATE store (Day 2: voice notes and photos). On Vercel, connecting
# the store to the project sets BLOB_STORE_ID and the SDK authenticates with OIDC.
# Locally, either `vercel env pull` (BLOB_STORE_ID + VERCEL_OIDC_TOKEN) or set
# BLOB_READ_WRITE_TOKEN. With none of these, dev stores media in .data/media.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Set to 1 to allow the local .data/media fallback under `pnpm start` (production build).
SITESYNC_LOCAL_MEDIA=

# Shared demo access code (proxy.ts gate). Required in production (fails closed
# without it); optional in development (open without it). Never commit a real one.
DEMO_ACCESS_CODE=

# --- Day 4: Web Push (VAPID). Generate once: `pnpm dlx web-push@3.6.7 generate-vapid-keys`.
# The public key is inlined into the client bundle at BUILD time (starts with "B",
# 87 characters); a changed key needs a rebuild and every device must re-subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@example.com
# Bearer secret for /api/escalations/run (Vercel Cron sends it automatically).
CRON_SECRET=

# --- Day 4: SMS fallback. mock (default) writes to the SMS log only. twilio texts
# ONE person for real (picked in /office/sms) at SMS_DEMO_TO_NUMBER; everyone else
# stays mock. Never store real numbers anywhere else.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEMO_TO_NUMBER=

# --- Day 5 ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
